generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  VENTAS
  STOCK
  REVENDEDOR
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FULFILLED
}

enum UploadType {
  IMAGE
  PDF
  DOC
  TEXT
  PAYMENT_PROOF
  OTHER
}

enum PersonalizationMethod {
  DTF
  DTG
  FULL_COLOR
  LASER
}

enum PaymentMethod {
  CASH
  TRANSFER
  COORDINATE
}

enum InvoiceType {
  CONSUMIDOR_FINAL
  IVA_EXENTO
  RESPONSABLE_INSCRIPTO
}

enum ShippingMethod {
  PICKUP
  MOTO
  COORDINATE_INTERIOR
}

enum MotoZone {
  CABA
  GBA1
  GBA2
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders   Order[]
  accounts Account[]
  sessions Session[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  basePrice    Int?
  baseUsdPrice Decimal? @db.Decimal(10, 2)
  weightGrams  Int?
  lenghtMm     Int?
  widthMm      Int?
  heightMm     Int?
  stock        Int?

  minQtyStep Int @default(1)

  allowedMethods PersonalizationMethod[] @default([])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]
  priceTiers  PriceTier[]
  supplierMap SupplierProduct[]
  categories  Category[]

  orderItems OrderItem[] // ✅ agregar esto
}

model IntegrationLock {
  key           String    @id
  isRunning     Boolean   @default(false)
  startedAt     DateTime?
  finishedAt    DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku               String  @unique
  colorName         String
  colorHex          String?
  stock             Int     @default(0)
  externalVariantId String?
  // opcional si algún color tiene precio distinto
  priceOverride     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // si querés imágenes por variante (opcional)
  images ProductImage[] // lo resolvemos abajo con un campo variantId

  supplierMaps SupplierProduct[]

  @@unique([productId, externalVariantId])
  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  active    Boolean   @default(true)
  order     Int       @default(0)
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String? // ✅ nuevo (opcional)

  url  String
  alt  String?
  sort Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, sort])
  @@index([productId])
  @@index([variantId])
}

model SupplierSyncState {
  key            String    @id
  supplierCode   String
  syncType       String //import_new | sync_stock_price
  currentIndex   Int       @default(0)
  totalRows      Int?
  status         String    @default("idle") //iddle | running | completed | error
  lastError      String?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

model PriceRule {
  id         String   @id @default(cuid())
  minUsd     Float //precio minimo en dolares (incluido)
  maxUsd     Float //precio maximo en dolares (excluido o podes usar hasta)
  multiplier Float // multiplicador de ganancia (ej: 2.0 , 1.9, etc)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([minUsd, maxUsd])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceTier {
  id        String @id @default(cuid())
  productId String
  minQty    Int
  price     Int // precio unitario para minQty o más

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@index([productId])
}

model Supplier {
  id     String  @id @default(cuid())
  name   String
  code   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products SupplierProduct[]
}

// Mapea un producto interno con el producto del proveedor (SKU/ID externo)
model SupplierProduct {
  id         String @id @default(cuid())
  supplierId String

  // 👇 ahora pueden ser null si todavía no está mapeado
  productId String?
  variantId String?

  externalId    String?
  externalSku   String?
  name          String?
  supplierStock Int?
  supplierPrice Int?
  lastSyncAt    DateTime?

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([supplierId, externalSku]) // ✅ clave para upsert
  @@index([supplierId])
  @@index([productId])
  @@index([variantId])
  @@index([externalSku])
}

model Order {
  id     String      @id @default(cuid())
  userId String?
  status OrderStatus @default(PENDING)

  subtotalNet Int @default(0)
  vatRate     Int @default(21) //porcentaje
  vatAmount   Int @default(0)
  shipping    Int @default(0)
  total       Int @default(0)

  paymentMethod    PaymentMethod @default(CASH)
  paymentSurcharge Int           @default(0)

  customerName        String?
  customerEmail       String?
  customerPhone       String?
  //Factura
  invoiceType         InvoiceType    @default(CONSUMIDOR_FINAL)
  invoiceCuit         String?
  invoiceBusinessName String?
  invoiceAddress      String?
  invoiceCity         String?
  invoicePostalCode   String?
  //Envio
  shippingMethod      ShippingMethod @default(PICKUP)
  motoZone            MotoZone?
  shipPostalCode      String?
  shipStreet          String?
  shipNumber          String?
  shipApartment       String?
  shipLocality        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  uploads OrderUpload[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([shipPostalCode])
  @@index([shipLocality])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  variantId  String? // ✅
  variantSku String? // ✅ snapshot
  colorName  String? // ✅ snapshot
  colorHex   String? // ✅ snapshot

  method PersonalizationMethod? // ✅ personalización elegida
  notes  String? // opcional

  qty       Int
  unitPrice Int
  lineTotal Int

  // snapshot para que no cambie si editás el producto después
  productName String
  productSlug String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderUpload {
  id           String     @id @default(cuid())
  orderId      String
  type         UploadType
  url          String? // Cloudinary (más adelante)
  text         String? // si sube texto personalizado
  originalName String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
